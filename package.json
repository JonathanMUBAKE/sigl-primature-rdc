{
  "name": "sigl-primature",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Systeme Integre de Gestion Logistique - Primature de la RDC",
  "scripts": {
    "dev": "concurrently -n serveur,web -c blue,green \"npm:dev:serveur\" \"npm:dev:web\"",
    "dev:serveur": "node --watch server/src/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/src/index.js",
    "test": "node --test --test-concurrency=1 server/src/**/*.test.js",
    "seed": "node server/seed/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^11.0.0",
    "@fontsource/cooper-hewitt": "^5.3.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.81.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.4.0"
  }
}
